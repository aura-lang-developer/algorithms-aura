import { NewGraph } from "../src/structures/graph";
import { BFS } from "../src/algorithms/graphs";

fn main() => {
  println("=== Ejemplo 26: Recorrido BFS en Grafo con Ciclos ===");
  let mut g = NewGraph(false);
  let v0 = g.AddVertex("A");
  let v1 = g.AddVertex("B");
  let v2 = g.AddVertex("C");
  g.AddEdge(v0, v1, 1);
  g.AddEdge(v1, v2, 1);
  g.AddEdge(v2, v0, 1);
  let orden = BFS(g, v0);
  println(`Orden de visita sin bucles infinitos: ${orden}`);
};
