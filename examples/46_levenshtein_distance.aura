import { LevenshteinDistance } from "../src/algorithms/strings";

fn main() => {
  println("=== Ejemplo 46: Distancia de Levenshtein (Edición de cadenas) ===");
  let s1 = "kitten";
  let s2 = "sitting";
  let dist = LevenshteinDistance(s1, s2);
  println(`Distancia de edición entre "${s1}" y "${s2}": ${dist}`);
};
