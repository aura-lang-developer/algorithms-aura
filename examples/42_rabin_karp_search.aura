import { RabinKarpSearch } from "../src/algorithms/strings";

fn main() => {
  println("=== Ejemplo 42: Algoritmo Rabin-Karp de Búsqueda con Hash ===");
  let texto = "HOLA MUNDO HOLA AURA";
