import { NewGraph } from "../src/structures/graph";
import { Dijkstra } from "../src/algorithms/graphs";

fn main() => {
  println("=== Ejemplo 25: Camino más corto con pesos uniformes ===");
  let mut g = NewGraph(false);
  let v0 = g.AddVertex("1");
  let v1 = g.AddVertex("2");
  let v2 = g.AddVertex("3");
  let v3 = g.AddVertex("4");
  g.AddEdge(v0, v1, 1);
  g.AddEdge(v1, v2, 1);
  g.AddEdge(v2, v3, 1);
  let saltos = Dijkstra(g, v0, v3);
  println(`Distancia en pasos de ${v0} a ${v3}: ${saltos}`);
};
