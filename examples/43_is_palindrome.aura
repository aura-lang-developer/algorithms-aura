import { IsPalindrome } from "../src/algorithms/strings";

fn main() => {
  println("=== Ejemplo 43: Verificación de Palíndromos ===");
  let palabra1 = "reconocer";
  let palabra2 = "algoritmo";
  println(`"${palabra1}" es palíndromo: ${IsPalindrome(palabra1)}`);
  println(`"${palabra2}" es palíndromo: ${IsPalindrome(palabra2)}`);
};
