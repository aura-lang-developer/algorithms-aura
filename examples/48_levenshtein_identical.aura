import { LevenshteinDistance } from "../src/algorithms/strings";

fn main() => {
  println("=== Ejemplo 48: Distancia de Levenshtein en Cadenas Idénticas ===");
  let palabra = "aura";
  let dist = LevenshteinDistance(palabra, palabra);
  println(`Distancia entre "${palabra}" y "${palabra}": ${dist}`);
};
