import { MaxSubarraySum } from "../src/algorithms/dynamic_programming";

fn main() => {
  println("=== Ejemplo 35: Algoritmo de Kadane (Max Subarray Sum) ===");
  let nums: []Int = [-2, 1, -3, 4, -1, 2, 1, -5, 4];
  let sumaMaxima = MaxSubarraySum(nums);
  println(`Suma máxima de subarreglo continuo: ${sumaMaxima}`);
};
