// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/structures/stack.aura - Implementación Idiomática de Pila LIFO (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Interfaz estructural `Stack` con despacho implícito (Duck Typing).
//   - Estructura pura `ArrayStack` respaldada por un slice contiguo (`[]Int`).
//   - Métodos con receptor de valor/mutación (`fn (s: ArrayStack) Push(...)`).
//   - Constructores canónicos `NewArrayStack()` / `NewStack()`.
//   - Manejo explícito de errores con `Result<T, String>` (equivalente a `(T, error)`).
//   - Métodos estándar de colección estilo Go: `Len()`, `IsEmpty()`.
//   - Funciones auxiliares compatibles para interoperabilidad directa.
// ==============================================================================

/// Interfaz estructural común para colecciones con comportamiento LIFO.
export interface Stack {
  Push(val: Int): Unit;
  Pop(): Result<Int, String>;
  Peek(): Result<Int, String>;
  IsEmpty(): Bool;
  Len(): Int;
  Clear(): Unit;
}

/// Estructura de Pila respaldada internamente por un slice dinámico continuo (`[]Int`).
export struct ArrayStack {
  __aura_type: String,
  stackItems: []Int,
};

/// Constructor idiomático estilo Go para crear una nueva instancia vacía de `ArrayStack`.
export fn NewArrayStack(): ArrayStack => {
  let initial: []Int = [];
  {
    __aura_type: "ArrayStack",
    stackItems: initial,
  }
};

/// Constructor alternativo de conveniencia para crear una pila.
export fn NewStack(): ArrayStack => NewArrayStack();

/// Constructor heredado para compatibilidad hacia atrás.
export fn newArrayStack(): ArrayStack => NewArrayStack();

// --- Métodos con Receptor (Go Method Receivers) ---

/// Push inserta un nuevo valor entero en el tope de la pila.
fn (s: ArrayStack) Push(val: Int): Unit => {
  s.stackItems.push(val);
  return;
}

/// Pop extrae y remueve el elemento superior del tope de la pila.
/// Retorna `Result<Int, String>`: `Ok(valor)` si tiene elementos o `Err(...)` si está vacía.
fn (s: ArrayStack) Pop(): Result<Int, String> => {
  if len(s.stackItems) == 0 {
    return Err("Pila vacía: no se puede ejecutar pop");
  }
  let lastIdx = len(s.stackItems) - 1;
  let val = s.stackItems[lastIdx];
  s.stackItems = s.stackItems[0:lastIdx];
  return Ok(val);
}

/// Peek consulta el valor del elemento en el tope sin retirarlo.
fn (s: ArrayStack) Peek(): Result<Int, String> => {
  if len(s.stackItems) == 0 {
    return Err("Pila vacía: no se puede ejecutar peek");
  }
  let lastIdx = len(s.stackItems) - 1;
  return Ok(s.stackItems[lastIdx]);
}

/// IsEmpty determina si la pila no contiene ningún elemento.
fn (s: ArrayStack) IsEmpty(): Bool => {
  return len(s.stackItems) == 0;
}

/// Len retorna la cantidad total de elementos actualmente en la pila (estilo `len(s)` de Go).
fn (s: ArrayStack) Len(): Int => {
  return len(s.stackItems);
}

/// Clear vacía y libera todos los elementos contenidos en la pila.
fn (s: ArrayStack) Clear(): Unit => {
  let emptyList: []Int = [];
  s.stackItems = emptyList;
  return;
}

// --- Algoritmo de Aplicación: Validación de Paréntesis ---

/// IsBalancedParentheses valida si una expresión contiene delimitadores balanceados: `()`, `[]`, `{}`.
export fn IsBalancedParentheses(expr: String): Bool => {
  let s = NewArrayStack();
  let mut i = 0;
  let exprLen = len(expr);

  while i < exprLen {
    let ch = expr[i];

    if ch == "(" {
      s.Push(1);
    } else if ch == "[" {
      s.Push(2);
    } else if ch == "{" {
      s.Push(3);
    } else if ch == ")" {
      if s.IsEmpty() { return false; }
      let topRes = s.Pop();
      let mut matched = false;
      match topRes {
        Ok(v) => { if v == 1 { matched = true; } },
        Err(_) => { matched = false; },
      };
      if !matched { return false; }
    } else if ch == "]" {
      if s.IsEmpty() { return false; }
      let topRes = s.Pop();
      let mut matched = false;
      match topRes {
        Ok(v) => { if v == 2 { matched = true; } },
        Err(_) => { matched = false; },
      };
      if !matched { return false; }
    } else if ch == "}" {
      if s.IsEmpty() { return false; }
      let topRes = s.Pop();
      let mut matched = false;
      match topRes {
        Ok(v) => { if v == 3 { matched = true; } },
        Err(_) => { matched = false; },
      };
      if !matched { return false; }
    }

    i = i + 1;
  }

  return s.IsEmpty();
};

export fn isBalancedParentheses(expr: String): Bool => IsBalancedParentheses(expr);

// --- Funciones Wrapper de Compatibilidad hacia atrás ---

export fn push(s: ArrayStack, val: Int): Unit => s.Push(val);
export fn pop(s: ArrayStack): Result<Int, String> => s.Pop();
export fn peek(s: ArrayStack): Result<Int, String> => s.Peek();
export fn isEmpty(s: ArrayStack): Bool => s.IsEmpty();
export fn stackSize(s: ArrayStack): Int => s.Len();
export fn clear(s: ArrayStack): Unit => s.Clear();
