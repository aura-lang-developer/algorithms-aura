// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/structures/linked_list.aura - Lista Enlazada y Lista ADT Funcional (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Interfaz estructural `LinkedList` con Duck Typing.
//   - Structs idiomáticos `ListNode` y `SinglyLinkedList` sobre memoria contigua.
//   - Métodos con receptor (`fn (l: SinglyLinkedList) Append(...)`).
//   - Constructores estándar `NewSinglyLinkedList()` / `NewLinkedList()`.
//   - Método de conversión a slice Go: `ToSlice()`.
//   - Funciones auxiliares compatibles para interoperabilidad directa.
// ==============================================================================

// --- 1. Interfaz Común y Lista Enlazada sobre Pool de Nodos ---

/// Interfaz estructural común para listas enlazadas.
export interface LinkedList {
  Prepend(val: Int): Unit;
  Append(val: Int): Unit;
  Delete(val: Int): Bool;
  Contains(val: Int): Bool;
  Reverse(): Unit;
  IsEmpty(): Bool;
  Len(): Int;
  ToSlice(): []Int;
}

/// Representa un nodo individual en el slice contiguo de la lista enlazada.
export struct ListNode {
  value: Int,
  next: Int,
};

/// Estructura de Lista Simplemente Enlazada con pool contiguo de nodos.
export struct SinglyLinkedList {
  __aura_type: String,
  nodes: []ListNode,
  head: Int,
  tail: Int,
  count: Int,
};

/// Constructor canónico estilo Go para inicializar una nueva lista enlazada vacía.
export fn NewSinglyLinkedList(): SinglyLinkedList => {
  let emptyNodes: []ListNode = [];
  {
    __aura_type: "SinglyLinkedList",
    nodes: emptyNodes,
    head: -1,
    tail: -1,
    count: 0,
  }
};

export fn NewLinkedList(): SinglyLinkedList => NewSinglyLinkedList();

export fn newSinglyLinkedList(): SinglyLinkedList => NewSinglyLinkedList();

// --- Métodos con Receptor para SinglyLinkedList ---

/// Len retorna la cantidad de elementos activos en la lista.
fn (l: SinglyLinkedList) Len(): Int => {
  return l.count;
}

/// IsEmpty determina si la lista enlazada no contiene nodos activos.
fn (l: SinglyLinkedList) IsEmpty(): Bool => {
  return l.count == 0;
}

/// Prepend inserta un nuevo elemento entero al inicio de la lista (nueva cabeza).
fn (l: SinglyLinkedList) Prepend(val: Int): Unit => {
  let newNodeIdx = len(l.nodes);
  let newNode: ListNode = {
    value: val,
    next: l.head,
  };
  l.nodes.push(newNode);

  if l.head == -1 {
    l.tail = newNodeIdx;
  }
  l.head = newNodeIdx;
  l.count = l.count + 1;
  return;
}

/// Append inserta un nuevo elemento entero al final de la lista (nueva cola).
fn (l: SinglyLinkedList) Append(val: Int): Unit => {
  let newNodeIdx = len(l.nodes);
  let newNode: ListNode = {
    value: val,
    next: -1,
  };
  l.nodes.push(newNode);

  if l.head == -1 {
    l.head = newNodeIdx;
    l.tail = newNodeIdx;
  } else {
    let oldTail = l.nodes[l.tail];
    l.nodes[l.tail] = {
      value: oldTail.value,
      next: newNodeIdx,
    };
    l.tail = newNodeIdx;
  }

  l.count = l.count + 1;
  return;
}

/// ToSlice vuelca y retorna los elementos de la lista enlazada en un slice secuencial (`[]Int`).
fn (l: SinglyLinkedList) ToSlice(): []Int => {
  let mut result: []Int = [];
  let mut curr = l.head;

  while curr != -1 {
    let node = l.nodes[curr];
    result.push(node.value);
    curr = node.next;
  }

  return result;
}

/// Contains busca si un valor entero existe dentro de la lista enlazada.
fn (l: SinglyLinkedList) Contains(val: Int): Bool => {
  let mut curr = l.head;

  while curr != -1 {
    let node = l.nodes[curr];
    if node.value == val {
      return true;
    }
    curr = node.next;
  }

  return false;
}

/// Delete elimina la primera ocurrencia de un valor entero en la lista.
fn (l: SinglyLinkedList) Delete(val: Int): Bool => {
  if l.head == -1 {
    return false;
  }

  let mut curr = l.head;
  let mut prev = -1;

  while curr != -1 {
    let node = l.nodes[curr];
    if node.value == val {
      if prev == -1 {
        l.head = node.next;
        if l.head == -1 {
          l.tail = -1;
        }
      } else {
        let prevNode = l.nodes[prev];
        l.nodes[prev] = {
          value: prevNode.value,
          next: node.next,
        };
        if node.next == -1 {
          l.tail = prev;
        }
      }
      l.count = l.count - 1;
      return true;
    }
    prev = curr;
    curr = node.next;
  }

  return false;
}

/// Reverse invierte in-place todos los enlaces de la lista enlazada.
fn (l: SinglyLinkedList) Reverse(): Unit => {
  if l.count <= 1 {
    return;
  }

  let mut prev = -1;
  let mut curr = l.head;
  l.tail = l.head;

  while curr != -1 {
    let nextNodeIdx = l.nodes[curr].next;
    let nodeVal = l.nodes[curr].value;

    l.nodes[curr] = {
      value: nodeVal,
      next: prev,
    };

    prev = curr;
    curr = nextNodeIdx;
  }

  l.head = prev;
  return;
}

// --- 2. Lista Enlazada Inmutable Funcional (ADT Recursivo) ---

/// Tipo Suma Algebraico (ADT) que representa una lista recursiva inmutable.
export type IntList =
  | Nil
  | Cons { head: Int, tail: IntList };

/// Constructor semántico de listas funcionales (`cons`).
export fn cons(head: Int, tail: IntList): IntList => {
  return IntList.Cons({ head: head, tail: tail });
};

/// ListLength calcula recursivamente la longitud total de una lista funcional.
export fn ListLength(l: IntList): Int => {
  match l {
    Nil => 0,
    Cons { head, tail } => 1 + ListLength(tail),
  }
};

export fn listLength(l: IntList): Int => ListLength(l);

/// ListSum calcula recursivamente la suma de todos los elementos contenidos.
export fn ListSum(l: IntList): Int => {
  match l {
    Nil => 0,
    Cons { head, tail } => head + ListSum(tail),
  }
};

export fn listSum(l: IntList): Int => ListSum(l);

/// ListContains determina si un valor está presente en la lista funcional.
export fn ListContains(l: IntList, target: Int): Bool => {
  match l {
    Nil => false,
    Cons { head, tail } => {
      if head == target {
        true
      } else {
        ListContains(tail, target)
      }
    },
  }
};

export fn adtListContains(l: IntList, target: Int): Bool => ListContains(l, target);

// --- Funciones Wrapper de Compatibilidad hacia atrás ---

export fn slistSize(list: SinglyLinkedList): Int => list.Len();
export fn slistIsEmpty(list: SinglyLinkedList): Bool => list.IsEmpty();
export fn slistPrepend(list: SinglyLinkedList, val: Int): Unit => list.Prepend(val);
export fn slistAppend(list: SinglyLinkedList, val: Int): Unit => list.Append(val);
export fn listToArray(list: SinglyLinkedList): []Int => list.ToSlice();
export fn slistContains(list: SinglyLinkedList, val: Int): Bool => list.Contains(val);
export fn slistDelete(list: SinglyLinkedList, val: Int): Bool => list.Delete(val);
export fn slistReverse(list: SinglyLinkedList): Unit => list.Reverse();
