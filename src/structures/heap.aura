// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/structures/heap.aura - Montículo Binario Mínimo (Min-Heap) (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Interfaz estructural `PriorityQueue` / `Heap` (Duck Typing).
//   - Struct continuo idiomático `MinHeap` sobre slice contiguo (`[]Int`).
//   - Métodos con receptor (`fn (h: MinHeap) Push(...)`).
//   - Constructor canónico `NewMinHeap()`.
//   - Manejo explícito de errores con `Result<Int, String>`.
//   - Algoritmo de ordenamiento `HeapSort` de la librería estándar.
//   - Wrappers compatibles para invocación funcional.
// ==============================================================================

/// Interfaz estructural común para colas de prioridad basadas en montículos.
export interface PriorityQueue {
  Push(val: Int): Unit;
  Pop(): Result<Int, String>;
  Peek(): Result<Int, String>;
  IsEmpty(): Bool;
  Len(): Int;
}

/// División entera truncada hacia cero sin residuo flotante.
fn intDiv(a: Int, b: Int): Int => {
  if b <= 0 || a < b { return 0; }
  let mut count = 0;
  let mut rem = a;
  while rem >= b {
    rem = rem - b;
    count = count + 1;
  }
  return count;
};

/// Estructura de Montículo Binario Mínimo respaldada por un slice contiguo.
export struct MinHeap {
  __aura_type: String,
  data: []Int,
};

/// Constructor canónico estilo Go para inicializar un MinHeap vacío.
export fn NewMinHeap(): MinHeap => {
  let initial: []Int = [];
  {
    __aura_type: "MinHeap",
    data: initial,
  }
};

export fn newMinHeap(): MinHeap => NewMinHeap();

// --- Métodos con Receptor para MinHeap ---

/// Len retorna la cantidad total de elementos contenidos en el montículo.
fn (h: MinHeap) Len(): Int => {
  return len(h.data);
}

/// IsEmpty verifica si el montículo carece de elementos.
fn (h: MinHeap) IsEmpty(): Bool => {
  return len(h.data) == 0;
}

/// Peek inspecciona el valor mínimo ubicado en la raíz sin extraerlo.
fn (h: MinHeap) Peek(): Result<Int, String> => {
  if len(h.data) == 0 {
    return Err("Montículo vacío: no se puede ejecutar peek");
  }
  return Ok(h.data[0]);
}

/// Push inserta un nuevo valor entero en el montículo y restablece la propiedad de min-heap (sift-up).
fn (h: MinHeap) Push(val: Int): Unit => {
  h.data.push(val);
  let mut idx = len(h.data) - 1;

  while idx > 0 {
    let parentIdx = intDiv(idx - 1, 2);
    if h.data[idx] < h.data[parentIdx] {
      let temp = h.data[idx];
      h.data[idx] = h.data[parentIdx];
      h.data[parentIdx] = temp;
      idx = parentIdx;
    } else {
      idx = 0;
    }
  }

  return;
}

/// Pop extrae y remueve el valor mínimo (la raíz) y restablece el montículo (sift-down).
fn (h: MinHeap) Pop(): Result<Int, String> => {
  let count = len(h.data);
  if count == 0 {
    return Err("Montículo vacío: no se puede ejecutar pop");
  }

  let minVal = h.data[0];
  let lastVal = h.data[count - 1];
  h.data = h.data[0:count - 1];

  let newCount = len(h.data);
  if newCount > 0 {
    h.data[0] = lastVal;
    let mut idx = 0;

    let mut running = true;
    while running {
      let left = (2 * idx) + 1;
      let right = (2 * idx) + 2;
      let mut smallest = idx;

      if left < newCount && h.data[left] < h.data[smallest] {
        smallest = left;
      }
      if right < newCount && h.data[right] < h.data[smallest] {
        smallest = right;
      }

      if smallest != idx {
        let temp = h.data[idx];
        h.data[idx] = h.data[smallest];
        h.data[smallest] = temp;
        idx = smallest;
      } else {
        running = false;
      }
    }
  }

  return Ok(minVal);
}

// --- Algoritmo HeapSort ---

/// HeapSort ordena un slice de enteros utilizando un MinHeap auxiliar en tiempo O(n log n).
export fn HeapSort(arr: []Int): []Int => {
  let heap = NewMinHeap();
  let mut i = 0;
  let n = len(arr);

  while i < n {
    heap.Push(arr[i]);
    i = i + 1;
  }

  let mut sorted: []Int = [];
  while !heap.IsEmpty() {
    let popRes = heap.Pop();
    match popRes {
      Ok(val) => {
        sorted.push(val);
        return;
      },
      Err(_) => {
        return;
      },
    };
  }

  return sorted;
};

export fn heapSort(arr: []Int): []Int => HeapSort(arr);

// --- Funciones Wrapper de Compatibilidad hacia atrás ---

export fn heapSize(h: MinHeap): Int => h.Len();
export fn heapPeek(h: MinHeap): Result<Int, String> => h.Peek();
export fn heapPush(h: MinHeap, val: Int): Unit => h.Push(val);
export fn heapPop(h: MinHeap): Result<Int, String> => h.Pop();
