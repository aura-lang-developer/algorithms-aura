// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/structures/binary_search_tree.aura - Árbol Binario de Búsqueda (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Interfaz estructural `SearchTree` (Duck Typing).
//   - Struct contenedor idiomático `BinarySearchTree` con receptor de métodos.
//   - Métodos con receptor (`fn (t: BinarySearchTree) Insert(...)`).
//   - Constructores estándar `NewBinarySearchTree()` / `NewBST()`.
//   - Retorno de errores con `Result<Int, String>`.
//   - Conversión y recorridos volcados a slices Go (`[]Int`).
//   - Interoperabilidad completa con funciones recursivas puras de BST.
// ==============================================================================

/// Tipo Suma Algebraico (ADT) que representa un nodo en el Árbol Binario de Búsqueda.
export type BST =
  | Empty
  | Node { value: Int, left: BST, right: BST };

/// Interfaz estructural común para árboles de búsqueda.
export interface SearchTree {
  Insert(val: Int): Unit;
  Search(val: Int): Bool;
  Min(): Result<Int, String>;
  Max(): Result<Int, String>;
  Height(): Int;
  Len(): Int;
  IsEmpty(): Bool;
  InOrder(): []Int;
}

// --- Funciones Puras Auxiliares del Árbol Recursivo ---

fn insertBSTInternal(tree: BST, val: Int): BST => {
  match tree {
    Empty => BST.Node({ value: val, left: BST.Empty, right: BST.Empty }),
    Node { value, left, right } => {
      if val < value {
        BST.Node({
          value: value,
          left: insertBSTInternal(left, val),
          right: right,
        })
      } else if val > value {
        BST.Node({
          value: value,
          left: left,
          right: insertBSTInternal(right, val),
        })
      } else {
        tree
      }
    },
  }
};

fn searchBSTInternal(tree: BST, val: Int): Bool => {
  match tree {
    Empty => false,
    Node { value, left, right } => {
      if val == value {
        true
      } else if val < value {
        searchBSTInternal(left, val)
      } else {
        searchBSTInternal(right, val)
      }
    },
  }
};

fn findMinBSTInternal(tree: BST): Result<Int, String> => {
  match tree {
    Empty => Err("Árbol vacío: no tiene valor mínimo"),
    Node { value, left, right } => {
      match left {
        Empty => Ok(value),
        Node { value: lVal, left: lLeft, right: lRight } => {
          findMinBSTInternal(left)
        },
      }
    },
  }
};

fn findMaxBSTInternal(tree: BST): Result<Int, String> => {
  match tree {
    Empty => Err("Árbol vacío: no tiene valor máximo"),
    Node { value, left, right } => {
      match right {
        Empty => Ok(value),
        Node { value: rVal, left: rLeft, right: rRight } => {
          findMaxBSTInternal(right)
        },
      }
    },
  }
};

fn treeHeightInternal(tree: BST): Int => {
  match tree {
    Empty => 0,
    Node { value, left, right } => {
      let hLeft = treeHeightInternal(left);
      let hRight = treeHeightInternal(right);
      let maxH = if hLeft > hRight { hLeft } else { hRight };
      1 + maxH
    },
  }
};

fn treeNodeCountInternal(tree: BST): Int => {
  match tree {
    Empty => 0,
    Node { value, left, right } => {
      1 + treeNodeCountInternal(left) + treeNodeCountInternal(right)
    },
  }
};

fn collectInOrder(tree: BST, acc: []Int): Unit => {
  match tree {
    Empty => { return; },
    Node { value, left, right } => {
      collectInOrder(left, acc);
      acc.push(value);
      collectInOrder(right, acc);
      return;
    },
  }
};

// --- Estructura Contenedora Go-Style ---

/// Estructura de Árbol Binario de Búsqueda al estilo de Go.
export struct BinarySearchTree {
  __aura_type: String,
  root: BST,
};

/// Constructor canónico estilo Go para inicializar un nuevo árbol BST vacío.
export fn NewBinarySearchTree(): BinarySearchTree => {
  {
    __aura_type: "BinarySearchTree",
    root: BST.Empty,
  }
};

export fn NewBST(): BinarySearchTree => NewBinarySearchTree();

export fn emptyBST(): BST => BST.Empty;

// --- Métodos con Receptor para BinarySearchTree ---

/// IsEmpty determina si el árbol BST no contiene nodos.
fn (t: BinarySearchTree) IsEmpty(): Bool => {
  match t.root {
    Empty => true,
    Node { value, left, right } => false,
  }
}

/// Len retorna la cantidad total de nodos activos en el árbol.
fn (t: BinarySearchTree) Len(): Int => {
  return treeNodeCountInternal(t.root);
}

/// Height calcula la altura máxima del árbol (0 si está vacío).
fn (t: BinarySearchTree) Height(): Int => {
  return treeHeightInternal(t.root);
}

/// Insert inserta un nuevo valor entero en el árbol preservando la propiedad BST.
fn (t: BinarySearchTree) Insert(val: Int): Unit => {
  t.root = insertBSTInternal(t.root, val);
  return;
}

/// Search busca si un valor entero existe dentro del árbol BST.
fn (t: BinarySearchTree) Search(val: Int): Bool => {
  return searchBSTInternal(t.root, val);
}

/// Min retorna el valor mínimo almacenado en el árbol BST.
fn (t: BinarySearchTree) Min(): Result<Int, String> => {
  return findMinBSTInternal(t.root);
}

/// Max retorna el valor máximo almacenado en el árbol BST.
fn (t: BinarySearchTree) Max(): Result<Int, String> => {
  return findMaxBSTInternal(t.root);
}

/// InOrder ejecuta un recorrido In-Order retornando los valores ordenados ascendentemente en un slice.
fn (t: BinarySearchTree) InOrder(): []Int => {
  let mut result: []Int = [];
  collectInOrder(t.root, result);
  return result;
}

// --- Métodos con Receptor para BST (ADT directo) ---

fn (tree: BST) IsEmpty(): Bool => isTreeEmpty(tree);
fn (tree: BST) Len(): Int => treeNodeCount(tree);
fn (tree: BST) Height(): Int => treeHeight(tree);

// --- Funciones Wrapper de Compatibilidad hacia atrás ---

export fn isTreeEmpty(tree: BST): Bool => {
  match tree {
    Empty => true,
    Node { value, left, right } => false,
  }
};

export fn insertBST(tree: BST, val: Int): BST => insertBSTInternal(tree, val);
export fn searchBST(tree: BST, val: Int): Bool => searchBSTInternal(tree, val);
export fn findMinBST(tree: BST): Result<Int, String> => findMinBSTInternal(tree);
export fn findMaxBST(tree: BST): Result<Int, String> => findMaxBSTInternal(tree);
export fn treeHeight(tree: BST): Int => treeHeightInternal(tree);
export fn treeNodeCount(tree: BST): Int => treeNodeCountInternal(tree);

export fn inOrderTraversal(tree: BST, acc: []Int): Unit => {
  collectInOrder(tree, acc);
  return;
};
