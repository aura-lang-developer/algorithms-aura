// ==============================================================================
// Algoritmos y Estructuras en Aura Lang
// src/structures/binary_search_tree.aura - Árbol Binario de Búsqueda (BST)
// ==============================================================================

/// Tipo Suma Algebraico (ADT) que representa un Árbol Binario de Búsqueda inmutable.
///
/// Propiedad invariante:
///   - Para todo nodo con valor V, todo nodo en su subárbol izquierdo tiene valor < V,
///     y todo nodo en su subárbol derecho tiene valor > V.
///
/// Variantes:
///   - `Empty`: Caso base, representa un árbol o subárbol vacío.
///   - `Node { value, left, right }`: Nodo con valor entero (`value`) y subárboles `left` y `right`.
export type BST =
  | Empty
  | Node { value: Int, left: BST, right: BST };

/// Retorna un árbol binario de búsqueda vacío (caso base `BST.Empty`).
///
/// Parámetros:
///   - Ninguno.
///
/// Retorno:
///   - `BST`: Árbol vacío sin nodos asignados.
///
/// Complejidad:
///   - Temporal: O(1)
///   - Espacial: O(1)
export fn emptyBST(): BST => {
  return BST.Empty;
};

/// Determina si el árbol binario no contiene ningún nodo.
///
/// Parámetros:
///   - `tree`: Instancia del árbol `BST` a evaluar.
///
/// Retorno:
///   - `Bool`: `true` si es `Empty`; `false` si es un `Node`.
///
/// Complejidad:
///   - Temporal: O(1)
///   - Espacial: O(1)
export fn isTreeEmpty(tree: BST): Bool => {
  match tree {
    Empty => true,
    Node { value, left, right } => false,
  }
};

/// Inserta un nuevo valor en el BST preservando estrictamente la propiedad de búsqueda.
///
/// Si el valor ya existe en el árbol, se retorna la estructura sin duplicados.
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST` donde se insertará el valor.
///   - `val`: Valor numérico entero (`Int`) a agregar.
///
/// Retorno:
///   - `BST`: Nuevo árbol inmutable que contiene el valor insertado.
///
/// Complejidad:
///   - Temporal: O(log n) en promedio, O(n) en el peor caso (árbol degenerado)
///   - Espacial: O(log n) promedio en la pila de llamadas
export fn insertBST(tree: BST, val: Int): BST => {
  match tree {
    Empty => BST.Node({ value: val, left: BST.Empty, right: BST.Empty }),
    Node { value, left, right } => {
      if val < value {
        BST.Node({
          value: value,
          left: insertBST(left, val),
          right: right,
        })
      } else if val > value {
        BST.Node({
          value: value,
          left: left,
          right: insertBST(right, val),
        })
      } else {
        // Valores duplicados se conservan sin duplicar nodos
        tree
      }
    },
  }
};

/// Busca si un valor entero existe dentro del árbol binario de búsqueda.
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST` a consultar.
///   - `target`: Valor entero (`Int`) que se desea localizar.
///
/// Retorno:
///   - `Bool`: `true` si el elemento está en el árbol; `false` en caso contrario.
///
/// Complejidad:
///   - Temporal: O(log n) promedio, O(n) peor caso
///   - Espacial: O(log n) en pila de llamadas
export fn searchBST(tree: BST, target: Int): Bool => {
  match tree {
    Empty => false,
    Node { value, left, right } => {
      if target == value {
        true
      } else if target < value {
        searchBST(left, target)
      } else {
        searchBST(right, target)
      }
    },
  }
};

/// Localiza y retorna el valor numérico mínimo contenido en el árbol (nodo más a la izquierda).
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST`.
///
/// Retorno:
///   - `Result<Int, String>`:
///     - `Ok(Int)`: El menor valor presente en el árbol.
///     - `Err(String)`: Mensaje de error si el árbol se encuentra vacío.
///
/// Complejidad:
///   - Temporal: O(log n) promedio, O(n) peor caso
///   - Espacial: O(log n) en pila recursiva
export fn findMinBST(tree: BST): Result<Int, String> => {
  match tree {
    Empty => Err("Árbol vacío: no posee valor mínimo"),
    Node { value, left, right } => {
      match left {
        Empty => Ok(value),
        Node { value: lVal, left: lLeft, right: lRight } => findMinBST(left),
      }
    },
  }
};

/// Localiza y retorna el valor numérico máximo contenido en el árbol (nodo más a la derecha).
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST`.
///
/// Retorno:
///   - `Result<Int, String>`:
///     - `Ok(Int)`: El mayor valor presente en el árbol.
///     - `Err(String)`: Mensaje de error si el árbol se encuentra vacío.
///
/// Complejidad:
///   - Temporal: O(log n) promedio, O(n) peor caso
///   - Espacial: O(log n) en pila recursiva
export fn findMaxBST(tree: BST): Result<Int, String> => {
  match tree {
    Empty => Err("Árbol vacío: no posee valor máximo"),
    Node { value, left, right } => {
      match right {
        Empty => Ok(value),
        Node { value: rVal, left: rLeft, right: rRight } => findMaxBST(right),
      }
    },
  }
};

/// Calcula recursivamente la altura del árbol (distancia máxima de la raíz a una hoja).
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST`.
///
/// Retorno:
///   - `Int`: Altura calculada (0 para árbol vacío, 1 para raíz solitaria).
///
/// Complejidad:
///   - Temporal: O(n) recorre todos los nodos
///   - Espacial: O(h) donde h es la altura del árbol
export fn treeHeight(tree: BST): Int => {
  match tree {
    Empty => 0,
    Node { value, left, right } => {
      let hl = treeHeight(left);
      let hr = treeHeight(right);
      let maxH = if hl > hr { hl } else { hr };
      1 + maxH
    },
  }
};

/// Cuenta la cantidad total de nodos existentes en el árbol binario.
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST`.
///
/// Retorno:
///   - `Int`: Número total de nodos contenidos.
///
/// Complejidad:
///   - Temporal: O(n)
///   - Espacial: O(h) en llamadas recursivas
export fn treeNodeCount(tree: BST): Int => {
  match tree {
    Empty => 0,
    Node { value, left, right } => {
      1 + treeNodeCount(left) + treeNodeCount(right)
    },
  }
};

/// Ejecuta un recorrido In-Order (Izquierda -> Raíz -> Derecha), acumulando los valores en orden ascendente.
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST` a recorrer.
///   - `acc`: Slice acumulador (`[]Int`) mutable donde se irán empujando los valores ordenados.
///
/// Retorno:
///   - `Unit`: Retorna `()` tras finalizar la visita de todos los nodos.
///
/// Complejidad:
///   - Temporal: O(n)
///   - Espacial: O(h)
export fn inOrderTraversal(tree: BST, acc: []Int): Unit => {
  match tree {
    Empty => { return; },
    Node { value, left, right } => {
      inOrderTraversal(left, acc);
      acc.push(value);
      inOrderTraversal(right, acc);
      return;
    },
  }
};

/// Ejecuta un recorrido Pre-Order (Raíz -> Izquierda -> Derecha), útil para clonar o serializar el árbol.
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST` a recorrer.
///   - `acc`: Slice acumulador (`[]Int`) mutable receptor de los valores.
///
/// Retorno:
///   - `Unit`: Retorna `()`.
///
/// Complejidad:
///   - Temporal: O(n)
///   - Espacial: O(h)
export fn preOrderTraversal(tree: BST, acc: []Int): Unit => {
  match tree {
    Empty => { return; },
    Node { value, left, right } => {
      acc.push(value);
      preOrderTraversal(left, acc);
      preOrderTraversal(right, acc);
      return;
    },
  }
};

/// Ejecuta un recorrido Post-Order (Izquierda -> Derecha -> Raíz), común en liberación jerárquica de recursos.
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST` a recorrer.
///   - `acc`: Slice acumulador (`[]Int`) mutable receptor de los valores.
///
/// Retorno:
///   - `Unit`: Retorna `()`.
///
/// Complejidad:
///   - Temporal: O(n)
///   - Espacial: O(h)
export fn postOrderTraversal(tree: BST, acc: []Int): Unit => {
  match tree {
    Empty => { return; },
    Node { value, left, right } => {
      postOrderTraversal(left, acc);
      postOrderTraversal(right, acc);
      acc.push(value);
      return;
    },
  }
};

/// Elimina un valor específico del árbol preservando la propiedad BST.
///
/// Si el nodo a eliminar tiene dos hijos, se reemplaza por su sucesor in-order (mínimo del subárbol derecho).
///
/// Parámetros:
///   - `tree`: Raíz del árbol `BST`.
///   - `target`: Valor entero (`Int`) que se desea suprimir.
///
/// Retorno:
///   - `BST`: Nuevo árbol reestructurado sin el elemento eliminado.
///
/// Complejidad:
///   - Temporal: O(log n) promedio, O(n) peor caso
///   - Espacial: O(h) en llamadas recursivas
export fn deleteBST(tree: BST, target: Int): BST => {
  match tree {
    Empty => BST.Empty,
    Node { value, left, right } => {
      if target < value {
        BST.Node({
          value: value,
          left: deleteBST(left, target),
          right: right,
        })
      } else if target > value {
        BST.Node({
          value: value,
          left: left,
          right: deleteBST(right, target),
        })
      } else {
        // Encontramos el nodo a eliminar
        match left {
          Empty => right,
          Node { value: lv, left: ll, right: lr } => {
            match right {
              Empty => left,
              Node { value: rv, left: rl, right: rr } => {
                // Caso con dos hijos: buscar el sucesor in-order (mínimo del subárbol derecho)
                let minRes = findMinBST(right);
                match minRes {
                  Ok(minVal) => {
                    BST.Node({
                      value: minVal,
                      left: left,
                      right: deleteBST(right, minVal),
                    })
                  },
                  Err(_) => left,
                }
              },
            }
          },
        }
      }
    },
  }
};
