// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/structures/trie.aura - Árbol de Prefijos (Trie / Prefix Tree) (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Interfaz estructural `PrefixTree` (Duck Typing).
//   - Structs idiomáticos `TrieNode` y `Trie` sobre pool continuo de memoria.
//   - Métodos con receptor (`fn (t: Trie) Insert(...)`).
//   - Constructor canónico `NewTrie()`.
//   - Métodos estándar de consulta: `Len()`.
//   - Wrappers funcionales de compatibilidad hacia atrás.
// ==============================================================================

/// Interfaz estructural común para árboles de prefijos (Trie).
export interface PrefixTree {
  Insert(word: String): Unit;
  Search(word: String): Bool;
  StartsWith(prefix: String): Bool;
  Len(): Int;
}

/// Representa un nodo individual en el árbol de prefijos.
export struct TrieNode {
  char: String,
  isEndOfWord: Bool,
  children: []Int,
};

/// Estructura de Árbol de Prefijos (Trie) respaldada por un pool secuencial de nodos.
export struct Trie {
  __aura_type: String,
  nodes: []TrieNode,
};

/// Constructor canónico estilo Go para inicializar un nuevo Trie con su raíz en el índice 0.
export fn NewTrie(): Trie => {
  let emptyChildren: []Int = [];
  let rootNode: TrieNode = {
    char: "",
    isEndOfWord: false,
    children: emptyChildren,
  };
  let mut nodesList: []TrieNode = [];
  nodesList.push(rootNode);
  {
    __aura_type: "Trie",
    nodes: nodesList,
  }
};

export fn newTrie(): Trie => NewTrie();

// --- Métodos con Receptor para Trie ---

/// Len retorna la cantidad total de nodos internos asignados en el Trie.
fn (t: Trie) Len(): Int => {
  return len(t.nodes);
}

/// Insert indexa una palabra completa carácter por carácter en el Trie.
fn (t: Trie) Insert(word: String): Unit => {
  let mut currentIdx = 0;
  let mut i = 0;
  let wordLen = len(word);

  while i < wordLen {
    let ch = word[i];
    let mut foundChildIdx = -1;

    let currChildren = t.nodes[currentIdx].children;
    let mut c = 0;
    let numChildren = len(currChildren);
    while c < numChildren {
      let childNodeIdx = currChildren[c];
      if t.nodes[childNodeIdx].char == ch {
        foundChildIdx = childNodeIdx;
      }
      c = c + 1;
    }

    if foundChildIdx == -1 {
      let newChildIdx = len(t.nodes);
      let emptyChildList: []Int = [];
      let newNode: TrieNode = {
        char: ch,
        isEndOfWord: false,
        children: emptyChildList,
      };
      t.nodes.push(newNode);
      t.nodes[currentIdx].children.push(newChildIdx);
      currentIdx = newChildIdx;
    } else {
      currentIdx = foundChildIdx;
    }

    i = i + 1;
  }

  let lastNode = t.nodes[currentIdx];
  t.nodes[currentIdx] = {
    char: lastNode.char,
    isEndOfWord: true,
    children: lastNode.children,
  };
  return;
}

/// Search verifica si una palabra exacta existe registrada en el Trie.
fn (t: Trie) Search(word: String): Bool => {
  let mut currentIdx = 0;
  let mut i = 0;
  let wordLen = len(word);

  while i < wordLen {
    let ch = word[i];
    let mut foundChildIdx = -1;

    let currChildren = t.nodes[currentIdx].children;
    let mut c = 0;
    let numChildren = len(currChildren);
    while c < numChildren {
      let childNodeIdx = currChildren[c];
      if t.nodes[childNodeIdx].char == ch {
        foundChildIdx = childNodeIdx;
      }
      c = c + 1;
    }

    if foundChildIdx == -1 {
      return false;
    }
    currentIdx = foundChildIdx;
    i = i + 1;
  }

  return t.nodes[currentIdx].isEndOfWord;
}

/// StartsWith determina si existe al menos una palabra que comience con el prefijo dado.
fn (t: Trie) StartsWith(prefix: String): Bool => {
  let mut currentIdx = 0;
  let mut i = 0;
  let prefixLen = len(prefix);

  while i < prefixLen {
    let ch = prefix[i];
    let mut foundChildIdx = -1;

    let currChildren = t.nodes[currentIdx].children;
    let mut c = 0;
    let numChildren = len(currChildren);
    while c < numChildren {
      let childNodeIdx = currChildren[c];
      if t.nodes[childNodeIdx].char == ch {
        foundChildIdx = childNodeIdx;
      }
      c = c + 1;
    }

    if foundChildIdx == -1 {
      return false;
    }
    currentIdx = foundChildIdx;
    i = i + 1;
  }

  return true;
}

// --- Funciones Wrapper de Compatibilidad hacia atrás ---

export fn insertWord(trie: Trie, word: String): Unit => trie.Insert(word);
export fn searchWord(trie: Trie, word: String): Bool => trie.Search(word);
export fn startsWith(trie: Trie, prefix: String): Bool => trie.StartsWith(prefix);
