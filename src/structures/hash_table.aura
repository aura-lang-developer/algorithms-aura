// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/structures/hash_table.aura - Tabla Hash con Encadenamiento (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Interfaz estructural `Map` (Duck Typing).
//   - Structs idiomáticos `HashEntry`, `HashBucket` y `HashTable`.
//   - Métodos con receptor (`fn (ht: HashTable) Put(...)`).
//   - Constructor canónico `NewHashTable(bucketCount: Int)`.
//   - Manejo explícito de errores con `Result<String, String>`.
//   - Wrappers funcionales para total compatibilidad hacia atrás.
// ==============================================================================

/// Interfaz estructural común para mapas asociativos clave-valor.
export interface MapInterface {
  Put(key: String, value: String): Unit;
  Get(key: String): Result<String, String>;
  Contains(key: String): Bool;
  Delete(key: String): Bool;
  Keys(): []String;
  IsEmpty(): Bool;
  Len(): Int;
}

/// Representa una entrada individual clave-valor.
export struct HashEntry {
  key: String,
  value: String,
};

/// Representa un casillero o "bucket" con encadenamiento separado.
export struct HashBucket {
  entries: []HashEntry,
};

/// Estructura de Tabla Hash con direccionamiento por buckets.
export struct HashTable {
  __aura_type: String,
  buckets: []HashBucket,
  bucketCount: Int,
  size: Int,
};

/// HashKey calcula un valor hash entero determinista para una clave textual.
export fn HashKey(key: String, cap: Int): Int => {
  let mut hash = 0;
  let mut i = 0;
  let keyLen = len(key);

  while i < keyLen {
    let c = key[i];
    let mut weight = 7;
    if c == "a" || c == "A" { weight = 1; }
    else if c == "b" || c == "B" { weight = 2; }
    else if c == "c" || c == "C" { weight = 3; }
    else if c == "d" || c == "D" { weight = 4; }
    else if c == "e" || c == "E" { weight = 5; }
    else if c == "f" || c == "F" { weight = 6; }
    else if c == "g" || c == "G" { weight = 7; }
    else if c == "h" || c == "H" { weight = 8; }
    else if c == "i" || c == "I" { weight = 9; }
    else if c == "j" || c == "J" { weight = 10; }
    else if c == "k" || c == "K" { weight = 11; }
    else if c == "l" || c == "L" { weight = 12; }
    else if c == "m" || c == "M" { weight = 13; }
    else if c == "n" || c == "N" { weight = 14; }
    else if c == "o" || c == "O" { weight = 15; }
    else if c == "p" || c == "P" { weight = 16; }
    else if c == "q" || c == "Q" { weight = 17; }
    else if c == "r" || c == "R" { weight = 18; }
    else if c == "s" || c == "S" { weight = 19; }
    else if c == "t" || c == "T" { weight = 20; }
    else if c == "u" || c == "U" { weight = 21; }
    else if c == "v" || c == "V" { weight = 22; }
    else if c == "w" || c == "W" { weight = 23; }
    else if c == "x" || c == "X" { weight = 24; }
    else if c == "y" || c == "Y" { weight = 25; }
    else if c == "z" || c == "Z" { weight = 26; }
    else { weight = 27 + (i % 10); }

    hash = (hash * 31 + weight) % cap;
    i = i + 1;
  }

  if hash < 0 {
    hash = hash + cap;
  }
  return hash;
};

export fn hashKey(key: String, cap: Int): Int => HashKey(key, cap);

/// Constructor canónico estilo Go para inicializar una nueva `HashTable`.
export fn NewHashTable(initBuckets: Int): HashTable => {
  let effectiveCap = if initBuckets < 4 { 16 } else { initBuckets };
  let mut buckets: []HashBucket = [];
  let mut i = 0;
  while i < effectiveCap {
    let emptyEntries: []HashEntry = [];
    let b: HashBucket = { entries: emptyEntries };
    buckets.push(b);
    i = i + 1;
  }
  {
    __aura_type: "HashTable",
    buckets: buckets,
    bucketCount: effectiveCap,
    size: 0,
  }
};

export fn newHashTable(initBuckets: Int): HashTable => NewHashTable(initBuckets);

// --- Métodos con Receptor para HashTable ---

/// Len retorna la cantidad total de pares clave-valor almacenados.
fn (ht: HashTable) Len(): Int => {
  return ht.size;
}

/// IsEmpty verifica si la tabla hash no contiene entradas.
fn (ht: HashTable) IsEmpty(): Bool => {
  return ht.size == 0;
}

/// Put inserta o actualiza una pareja clave-valor en la tabla hash.
fn (ht: HashTable) Put(key: String, value: String): Unit => {
  let bucketIdx = HashKey(key, ht.bucketCount);
  let bucket = ht.buckets[bucketIdx];

  let mut i = 0;
  let entryCount = len(bucket.entries);
  while i < entryCount {
    if bucket.entries[i].key == key {
      bucket.entries[i] = { key: key, value: value };
      return;
    }
    i = i + 1;
  }

  let newEntry: HashEntry = { key: key, value: value };
  bucket.entries.push(newEntry);
  ht.size = ht.size + 1;
  return;
}

/// Get recupera el valor asociado a una clave o retorna `Err(...)` si no existe.
fn (ht: HashTable) Get(key: String): Result<String, String> => {
  let bucketIdx = HashKey(key, ht.bucketCount);
  let bucket = ht.buckets[bucketIdx];

  let mut i = 0;
  let entryCount = len(bucket.entries);
  while i < entryCount {
    if bucket.entries[i].key == key {
      return Ok(bucket.entries[i].value);
    }
    i = i + 1;
  }

  return Err(`Clave no encontrada: '${key}'`);
}

/// Contains determina si una clave dada existe en la tabla hash.
fn (ht: HashTable) Contains(key: String): Bool => {
  let res = ht.Get(key);
  match res {
    Ok(_) => true,
    Err(_) => false,
  }
}

/// Delete elimina una clave y su valor asociado retornando `true` si fue removida.
fn (ht: HashTable) Delete(key: String): Bool => {
  let bucketIdx = HashKey(key, ht.bucketCount);
  let bucket = ht.buckets[bucketIdx];

  let mut i = 0;
  let entryCount = len(bucket.entries);
  while i < entryCount {
    if bucket.entries[i].key == key {
      let mut nextEntries: []HashEntry = [];
      let mut j = 0;
      while j < entryCount {
        if j != i {
          nextEntries.push(bucket.entries[j]);
        }
        j = j + 1;
      }
      bucket.entries = nextEntries;
      ht.size = ht.size - 1;
      return true;
    }
    i = i + 1;
  }

  return false;
}

/// Keys retorna un slice con todas las claves registradas en la tabla hash.
fn (ht: HashTable) Keys(): []String => {
  let mut keysList: []String = [];
  let mut bIdx = 0;
  let numBuckets = len(ht.buckets);
  while bIdx < numBuckets {
    let bucket = ht.buckets[bIdx];
    let mut eIdx = 0;
    let numEntries = len(bucket.entries);
    while eIdx < numEntries {
      keysList.push(bucket.entries[eIdx].key);
      eIdx = eIdx + 1;
    }
    bIdx = bIdx + 1;
  }
  return keysList;
}

// --- Funciones Wrapper de Compatibilidad hacia atrás ---

export fn put(ht: HashTable, key: String, value: String): Unit => ht.Put(key, value);
export fn get(ht: HashTable, key: String): Result<String, String> => ht.Get(key);
export fn containsKey(ht: HashTable, key: String): Bool => ht.Contains(key);
export fn removeKey(ht: HashTable, key: String): Bool => ht.Delete(key);
export fn getAllKeys(ht: HashTable): []String => ht.Keys();
