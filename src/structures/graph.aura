// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/structures/graph.aura - Grafo con Lista de Adyacencia (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Interfaz estructural `GraphInterface` (Duck Typing).
//   - Structs idiomáticos `GraphEdge`, `GraphVertex` y `Graph`.
//   - Métodos con receptor (`fn (g: Graph) AddVertex(...)`).
//   - Constructor canónico `NewGraph(isDirected: Bool)`.
//   - Consulta de cardinalidad estándar `Len()` y `VertexCount()`.
//   - Wrappers funcionales de compatibilidad hacia atrás.
// ==============================================================================

/// Interfaz estructural común para grafos ponderados.
export interface GraphInterface {
  AddVertex(label: String): Int;
  AddEdge(fromId: Int, toId: Int, weight: Int): Unit;
  VertexCount(): Int;
  Len(): Int;
  GetNeighbors(vertexId: Int): []Int;
  GetDegree(vertexId: Int): Int;
}

/// Representa una arista dirigida ponderada hacia un vértice destino.
export struct GraphEdge {
  to: Int,
  weight: Int,
};

/// Representa un vértice individual en el grafo.
export struct GraphVertex {
  id: Int,
  label: String,
  edges: []GraphEdge,
};

/// Estructura de Grafo basada en listas de adyacencia contiguas.
export struct Graph {
  __aura_type: String,
  vertices: []GraphVertex,
  isDirected: Bool,
};

/// Constructor canónico estilo Go para inicializar un nuevo grafo vacío.
export fn NewGraph(isDirected: Bool): Graph => {
  let initialVertices: []GraphVertex = [];
  {
    __aura_type: "Graph",
    vertices: initialVertices,
    isDirected: isDirected,
  }
};

export fn newGraph(isDirected: Bool): Graph => NewGraph(isDirected);

// --- Métodos con Receptor para Graph ---

/// Len retorna la cantidad total de vértices registrados en el grafo.
fn (g: Graph) Len(): Int => {
  return len(g.vertices);
}

/// VertexCount retorna la cantidad total de vértices (|V|).
fn (g: Graph) VertexCount(): Int => {
  return len(g.vertices);
}

/// AddVertex agrega un nuevo vértice al grafo y retorna su identificador único asignado.
fn (g: Graph) AddVertex(label: String): Int => {
  let id = len(g.vertices);
  let emptyEdges: []GraphEdge = [];
  let v: GraphVertex = {
    id: id,
    label: label,
    edges: emptyEdges,
  };
  g.vertices.push(v);
  return id;
}

/// AddEdge conecta dos vértices existentes mediante una arista con peso.
fn (g: Graph) AddEdge(fromId: Int, toId: Int, weight: Int): Unit => {
  let numV = len(g.vertices);
  if fromId < 0 || fromId >= numV || toId < 0 || toId >= numV {
    return;
  }

  let edgeForward: GraphEdge = { to: toId, weight: weight };
  g.vertices[fromId].edges.push(edgeForward);

  if !g.isDirected && fromId != toId {
    let edgeBackward: GraphEdge = { to: fromId, weight: weight };
    g.vertices[toId].edges.push(edgeBackward);
  }
  return;
}

/// GetNeighbors retorna los identificadores de todos los vértices adyacentes a `vertexId`.
fn (g: Graph) GetNeighbors(vertexId: Int): []Int => {
  let mut neighbors: []Int = [];
  let numV = len(g.vertices);
  if vertexId < 0 || vertexId >= numV {
    return neighbors;
  }

  let edges = g.vertices[vertexId].edges;
  let mut i = 0;
  let numEdges = len(edges);
  while i < numEdges {
    neighbors.push(edges[i].to);
    i = i + 1;
  }

  return neighbors;
}

/// GetDegree retorna el número de aristas conectadas al vértice consultado.
fn (g: Graph) GetDegree(vertexId: Int): Int => {
  let numV = len(g.vertices);
  if vertexId < 0 || vertexId >= numV {
    return 0;
  }
  return len(g.vertices[vertexId].edges);
}

// --- Funciones Wrapper de Compatibilidad hacia atrás ---

export fn addVertex(g: Graph, label: String): Int => g.AddVertex(label);
export fn addEdge(g: Graph, fromId: Int, toId: Int, weight: Int): Unit => g.AddEdge(fromId, toId, weight);
export fn vertexCount(g: Graph): Int => g.VertexCount();
export fn getNeighbors(g: Graph, vertexId: Int): []Int => g.GetNeighbors(vertexId);
export fn getDegree(g: Graph, vertexId: Int): Int => g.GetDegree(vertexId);
