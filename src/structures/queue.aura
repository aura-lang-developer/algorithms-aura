// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/structures/queue.aura - Colas FIFO, Búfer Circular y Deque (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Interfaces estructurales `QueueInterface` y `DequeInterface` (Duck Typing).
//   - Structs idiomáticos `Queue`, `CircularBuffer` y `Deque`.
//   - Receptores de métodos (`fn (q: Queue) Enqueue(...)`).
//   - Constructores estándar `NewQueue()`, `NewCircularBuffer()`, `NewDeque()`.
//   - Manejo explícito de errores con `Result<T, String>`.
//   - Consultas de cardinalidad con método `Len()`.
//   - Aliases y wrappers de compatibilidad para código existente.
// ==============================================================================

// --- 1. Interfaz y Cola FIFO Estándar ---

/// Interfaz estructural común para colas FIFO (First-In, First-Out).
export interface QueueInterface {
  Enqueue(val: Int): Unit;
  Dequeue(): Result<Int, String>;
  Peek(): Result<Int, String>;
  IsEmpty(): Bool;
  Len(): Int;
}

/// Estructura de Cola basada en un slice continuo con cursor frontal móvil.
export struct Queue {
  __aura_type: String,
  queueItems: []Int,
  headIndex: Int,
};

/// Type alias para compatibilidad.
export type ArrayQueue = Queue;

/// Constructor canónico estilo Go para inicializar una cola FIFO vacía.
export fn NewQueue(): Queue => {
  let initial: []Int = [];
  {
    __aura_type: "Queue",
    queueItems: initial,
    headIndex: 0,
  }
};

/// Constructor idiomático alternativo.
export fn NewArrayQueue(): Queue => NewQueue();

/// Constructor heredado para compatibilidad hacia atrás.
export fn newQueue(): Queue => NewQueue();

// --- Métodos con Receptor para Queue ---

/// Enqueue inserta un nuevo elemento entero al final de la cola.
fn (q: Queue) Enqueue(val: Int): Unit => {
  q.queueItems.push(val);
  return;
}

/// Dequeue extrae y remueve el primer elemento del frente de la cola.
/// Aplica compactación amortizada cuando el cursor frontal supera el umbral de 32 elementos.
fn (q: Queue) Dequeue(): Result<Int, String> => {
  let activeCount = len(q.queueItems) - q.headIndex;
  if activeCount <= 0 {
    return Err("Cola vacía: no se puede ejecutar dequeue");
  }

  let val = q.queueItems[q.headIndex];
  q.headIndex = q.headIndex + 1;

  // Compactar el slice cuando el residuo alcance el umbral
  if q.headIndex >= 32 && q.headIndex >= (len(q.queueItems) / 2) {
    q.queueItems = q.queueItems[q.headIndex:len(q.queueItems)];
    q.headIndex = 0;
  }

  return Ok(val);
}

/// Peek consulta el elemento ubicado en el frente de la cola sin removerlo.
fn (q: Queue) Peek(): Result<Int, String> => {
  let activeCount = len(q.queueItems) - q.headIndex;
  if activeCount <= 0 {
    return Err("Cola vacía: no se puede ejecutar peek");
  }
  return Ok(q.queueItems[q.headIndex]);
}

/// IsEmpty determina si la cola no tiene elementos activos pendientes.
fn (q: Queue) IsEmpty(): Bool => {
  return (len(q.queueItems) - q.headIndex) <= 0;
}

/// Len retorna la cantidad de elementos activos actualmente en la cola (estilo Go).
fn (q: Queue) Len(): Int => {
  let count = len(q.queueItems) - q.headIndex;
  if count < 0 {
    return 0;
  }
  return count;
}

// --- 2. Búfer Circular (Ring Buffer con Capacidad Fija) ---

/// Estructura de Búfer Circular con capacidad estática finita y aritmética modular.
export struct CircularBuffer {
  __aura_type: String,
  data: []Int,
  maxCapacity: Int,
  head: Int,
  tail: Int,
  count: Int,
};

/// Constructor de Búfer Circular con capacidad acotada en tiempo real.
export fn NewCircularBuffer(cap: Int): CircularBuffer => {
  let effectiveCap = if cap < 1 { 8 } else { cap };
  let mut initialData: []Int = [];
  let mut i = 0;
  while i < effectiveCap {
    initialData.push(0);
    i = i + 1;
  }
  {
    __aura_type: "CircularBuffer",
    data: initialData,
    maxCapacity: effectiveCap,
    head: 0,
    tail: 0,
    count: 0,
  }
};

export fn newCircularBuffer(cap: Int): CircularBuffer => NewCircularBuffer(cap);

// --- Métodos con Receptor para CircularBuffer ---

/// IsFull verifica si el búfer circular ha alcanzado su capacidad máxima permitida.
fn (cb: CircularBuffer) IsFull(): Bool => {
  return cb.count == cb.maxCapacity;
}

/// IsEmpty verifica si el búfer circular se encuentra totalmente vacío.
fn (cb: CircularBuffer) IsEmpty(): Bool => {
  return cb.count == 0;
}

/// Len retorna la cantidad de posiciones activas en el búfer circular.
fn (cb: CircularBuffer) Len(): Int => {
  return cb.count;
}

/// Enqueue inserta un valor entero en el búfer circular si existe capacidad disponible.
fn (cb: CircularBuffer) Enqueue(val: Int): Bool => {
  if cb.IsFull() {
    return false;
  }
  cb.data[cb.tail] = val;
  cb.tail = (cb.tail + 1) % cb.maxCapacity;
  cb.count = cb.count + 1;
  return true;
}

/// Dequeue extrae el elemento más antiguo del frente del búfer circular.
fn (cb: CircularBuffer) Dequeue(): Result<Int, String> => {
  if cb.IsEmpty() {
    return Err("Búfer circular vacío");
  }
  let val = cb.data[cb.head];
  cb.head = (cb.head + 1) % cb.maxCapacity;
  cb.count = cb.count - 1;
  return Ok(val);
}

// --- 3. Deque (Double-Ended Queue / Cola de Doble Extremo) ---

/// Interfaz estructural común para colas de doble extremo.
export interface DequeInterface {
  PushBack(val: Int): Unit;
  PushFront(val: Int): Unit;
  PopFront(): Result<Int, String>;
  PopBack(): Result<Int, String>;
  IsEmpty(): Bool;
  Len(): Int;
}

/// Estructura de Cola de Doble Extremo respaldada por un slice dinámico continuo.
export struct Deque {
  __aura_type: String,
  dequeItems: []Int,
};

/// Type alias para compatibilidad.
export type ArrayDeque = Deque;

/// Constructor canónico para crear una instancia vacía de Deque.
export fn NewDeque(): Deque => {
  let list: []Int = [];
  {
    __aura_type: "Deque",
    dequeItems: list,
  }
};

export fn NewArrayDeque(): Deque => NewDeque();

export fn newDeque(): Deque => NewDeque();

// --- Métodos con Receptor para Deque ---

/// Len retorna la cantidad de elementos en el Deque.
fn (d: Deque) Len(): Int => {
  return len(d.dequeItems);
}

/// IsEmpty verifica si el Deque no contiene elementos.
fn (d: Deque) IsEmpty(): Bool => {
  return len(d.dequeItems) == 0;
}

/// PushBack inserta un valor entero al final del Deque.
fn (d: Deque) PushBack(val: Int): Unit => {
  d.dequeItems.push(val);
  return;
}

/// PushFront inserta un valor entero al frente del Deque.
fn (d: Deque) PushFront(val: Int): Unit => {
  let mut nextList: []Int = [val];
  let mut i = 0;
  let currentLen = len(d.dequeItems);
  while i < currentLen {
    nextList.push(d.dequeItems[i]);
    i = i + 1;
  }
  d.dequeItems = nextList;
  return;
}

/// PopFront extrae y remueve el valor ubicado al frente del Deque.
fn (d: Deque) PopFront(): Result<Int, String> => {
  if len(d.dequeItems) == 0 {
    return Err("Deque vacío: no se puede ejecutar popFront");
  }
  let val = d.dequeItems[0];
  d.dequeItems = d.dequeItems[1:len(d.dequeItems)];
  return Ok(val);
}

/// PopBack extrae y remueve el valor ubicado al final del Deque.
fn (d: Deque) PopBack(): Result<Int, String> => {
  if len(d.dequeItems) == 0 {
    return Err("Deque vacío: no se puede ejecutar popBack");
  }
  let lastIdx = len(d.dequeItems) - 1;
  let val = d.dequeItems[lastIdx];
  d.dequeItems = d.dequeItems[0:lastIdx];
  return Ok(val);
}

// --- Funciones Wrapper de Compatibilidad hacia atrás ---

export fn enqueue(q: Queue, val: Int): Unit => q.Enqueue(val);
export fn dequeue(q: Queue): Result<Int, String> => q.Dequeue();
export fn queuePeek(q: Queue): Result<Int, String> => q.Peek();
export fn isQueueEmpty(q: Queue): Bool => q.IsEmpty();
export fn queueSize(q: Queue): Int => q.Len();

export fn cbEnqueue(cb: CircularBuffer, val: Int): Bool => cb.Enqueue(val);
export fn cbDequeue(cb: CircularBuffer): Result<Int, String> => cb.Dequeue();
export fn cbIsFull(cb: CircularBuffer): Bool => cb.IsFull();
export fn cbIsEmpty(cb: CircularBuffer): Bool => cb.IsEmpty();
export fn cbSize(cb: CircularBuffer): Int => cb.Len();

export fn pushFront(d: Deque, val: Int): Unit => d.PushFront(val);
export fn pushBack(d: Deque, val: Int): Unit => d.PushBack(val);
export fn popFront(d: Deque): Result<Int, String> => d.PopFront();
export fn popBack(d: Deque): Result<Int, String> => d.PopBack();
export fn dequeSize(d: Deque): Int => d.Len();
export fn isDequeEmpty(d: Deque): Bool => d.IsEmpty();
