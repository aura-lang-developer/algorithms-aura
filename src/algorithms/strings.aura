// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/algorithms/strings.aura - Procesamiento de Cadenas (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Estilo paquete estándar `strings` de Go.
//   - Nombres exportados canónicos en PascalCase (`NaivePatternSearch`, `IsPalindrome`).
//   - Uso de `len(s)` para manejo canónico de cadenas y slices.
//   - Retornos tempranos y guard clauses.
//   - Wrappers funcionales de compatibilidad hacia atrás.
// ==============================================================================

/// NaivePatternSearch busca todas las apariciones de un patrón dentro de un texto.
export fn NaivePatternSearch(text: String, pattern: String): []Int => {
  let mut matches: []Int = [];
  let n = len(text);
  let m = len(pattern);

  if m == 0 || m > n {
    return matches;
  }

  let limit = n - m;
  let mut i = 0;
  while i <= limit {
    let mut j = 0;
    let mut matched = true;

    while j < m {
      if text[i + j] != pattern[j] {
        matched = false;
        j = m;
      } else {
        j = j + 1;
      }
    }

    if matched {
      matches.push(i);
    }
    i = i + 1;
  }

  return matches;
};

export fn naivePatternSearch(text: String, pattern: String): []Int => NaivePatternSearch(text, pattern);

/// RabinKarpSearch busca patrones con rolling hash polinomial en tiempo promedio O(n + m).
export fn RabinKarpSearch(text: String, pattern: String): []Int => {
  let mut matches: []Int = [];
  let n = len(text);
  let m = len(pattern);

  if m == 0 || m > n {
    return matches;
  }

  let primeBase = 31;
  let primeMod = 1000003;

  let mut h = 1;
  let mut k = 0;
  while k < (m - 1) {
    h = (h * primeBase) % primeMod;
    k = k + 1;
  }

  let charVal = fn(ch: String): Int => {
    if ch == "a" || ch == "A" { return 1; }
    if ch == "b" || ch == "B" { return 2; }
    if ch == "c" || ch == "C" { return 3; }
    if ch == "d" || ch == "D" { return 4; }
    if ch == "e" || ch == "E" { return 5; }
    if ch == "l" || ch == "L" { return 12; }
    if ch == "o" || ch == "O" { return 15; }
    if ch == "r" || ch == "R" { return 18; }
    if ch == "u" || ch == "U" { return 21; }
    return 7;
  };

  let mut patternHash = 0;
  let mut windowHash = 0;
  let mut i = 0;
  while i < m {
    patternHash = (patternHash * primeBase + charVal(pattern[i])) % primeMod;
    windowHash = (windowHash * primeBase + charVal(text[i])) % primeMod;
    i = i + 1;
  }

  let limit = n - m;
  let mut s = 0;
  while s <= limit {
    if windowHash == patternHash {
      let mut matched = true;
      let mut j = 0;
      while j < m {
        if text[s + j] != pattern[j] {
          matched = false;
          j = m;
        } else {
          j = j + 1;
        }
      }
      if matched {
        matches.push(s);
      }
    }

    if s < limit {
      let removeVal = (charVal(text[s]) * h) % primeMod;
      let addVal = charVal(text[s + m]);
      let nextHash = (windowHash - removeVal + primeMod) % primeMod;
      windowHash = (nextHash * primeBase + addVal) % primeMod;
    }

    s = s + 1;
  }

  return matches;
};

export fn rabinKarpSearch(text: String, pattern: String): []Int => RabinKarpSearch(text, pattern);

/// IsPalindrome verifica si una cadena es simétrica utilizando dos punteros convergentes.
export fn IsPalindrome(s: String): Bool => {
  let count = len(s);
  if count <= 1 {
    return true;
  }

  let mut left = 0;
  let mut right = count - 1;

  while left < right {
    if s[left] != s[right] {
      return false;
    }
    left = left + 1;
    right = right - 1;
  }

  return true;
};

export fn isPalindrome(s: String): Bool => IsPalindrome(s);

/// IsAnagram determina si dos cadenas contienen idénticas frecuencias de caracteres.
export fn IsAnagram(s1: String, s2: String): Bool => {
  if len(s1) != len(s2) {
    return false;
  }

  let mut freqs: []Int = [];
  let mut i = 0;
  while i < 128 {
    freqs.push(0);
    i = i + 1;
  }

  let getCode = fn(ch: String): Int => {
    if ch == "a" { return 0; }
    if ch == "b" { return 1; }
    if ch == "c" { return 2; }
    if ch == "d" { return 3; }
    if ch == "e" { return 4; }
    if ch == "l" { return 11; }
    if ch == "m" { return 12; }
    if ch == "o" { return 14; }
    if ch == "r" { return 17; }
    if ch == "s" { return 18; }
    if ch == "t" { return 19; }
    if ch == "u" { return 20; }
    return 30;
  };

  let mut j = 0;
  let count = len(s1);
  while j < count {
    let c1 = getCode(s1[j]);
    let c2 = getCode(s2[j]);
    freqs[c1] = freqs[c1] + 1;
    freqs[c2] = freqs[c2] - 1;
    j = j + 1;
  }

  let mut k = 0;
  while k < 128 {
    if freqs[k] != 0 {
      return false;
    }
    k = k + 1;
  }

  return true;
};

export fn isAnagram(s1: String, s2: String): Bool => IsAnagram(s1, s2);

/// ReverseString invierte el orden de los caracteres de una cadena.
export fn ReverseString(s: String): String => {
  let mut reversed = "";
  let mut i = len(s) - 1;

  while i >= 0 {
    reversed = `${reversed}${s[i]}`;
    i = i - 1;
  }

  return reversed;
};

export fn reverseString(s: String): String => ReverseString(s);

/// LevenshteinDistance calcula la cantidad mínima de operaciones de edición entre s1 y s2.
export fn LevenshteinDistance(s1: String, s2: String): Int => {
  let m = len(s1);
  let n = len(s2);
  let totalCells = (m + 1) * (n + 1);

  let mut dp: []Int = [];
  let mut k = 0;
  while k < totalCells {
    dp.push(0);
    k = k + 1;
  }

  let mut i = 0;
  while i <= m {
    dp[i * (n + 1)] = i;
    i = i + 1;
  }

  let mut j = 0;
  while j <= n {
    dp[j] = j;
    j = j + 1;
  }

  let mut r = 1;
  while r <= m {
    let mut c = 1;
    while c <= n {
      let cost = if s1[r - 1] == s2[c - 1] { 0 } else { 1 };
      let delCost = dp[(r - 1) * (n + 1) + c] + 1;
      let insCost = dp[r * (n + 1) + (c - 1)] + 1;
      let subCost = dp[(r - 1) * (n + 1) + (c - 1)] + cost;

      let mut minVal = delCost;
      if insCost < minVal { minVal = insCost; }
      if subCost < minVal { minVal = subCost; }

      dp[r * (n + 1) + c] = minVal;
      c = c + 1;
    }
    r = r + 1;
  }

  return dp[m * (n + 1) + n];
};

export fn levenshteinDistance(s1: String, s2: String): Int => LevenshteinDistance(s1, s2);
