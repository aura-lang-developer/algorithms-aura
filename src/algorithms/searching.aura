// ==============================================================================

/// Realiza una división entera truncada hacia cero sin residuo decimal.
///
/// Parámetros:
///   - `a`: Dividendo entero positivo.
///   - `b`: Divisor entero positivo.
///
/// Retorno:
///   - `Int`: Cociente entero truncado.
///
/// Complejidad:
///   - Temporal: O(a/b)
///   - Espacial: O(1)
fn intDiv(a: Int, b: Int): Int => {
  if b <= 0 || a < b { return 0; }
  let mut count = 0;
  let mut rem = a;
  while rem >= b {
    rem = rem - b;
    count = count + 1;
  }
  return count;
};

/// Calcula la raíz cuadrada entera truncada floor(sqrt(n)).
///
/// Parámetros:
///   - `n`: Valor entero no negativo (`Int`).
///
/// Retorno:
///   - `Int`: El mayor entero x tal que x*x <= n.
///
/// Complejidad:
///   - Temporal: O(sqrt(n))
///   - Espacial: O(1)
fn integerSqrt(n: Int): Int => {
  if n <= 0 { return 0; }
  let mut x = 1;
  let mut sq = x * x;
  while sq <= n {
    x = x + 1;
    sq = x * x;
  }
  return x - 1;
};

/// Algoritmo Linear Search (Búsqueda Lineal / Secuencial).
///
/// Escanea secuencialmente cada posición hasta hallar el valor buscado.
/// No impone requisitos de orden previo sobre la colección.
///
/// Parámetros:
///   - `arr`: Slice de enteros a examinar (`[]Int`).
///   - `target`: Valor entero buscado (`Int`).
///
/// Retorno:
///   - `Int`: Índice base 0 donde reside el elemento; -1 si no fue encontrado.
///
/// Complejidad:
///   - Temporal: O(n) peor caso, O(1) mejor caso (primer elemento)
///   - Espacial: O(1)
export fn linearSearch(arr: []Int, target: Int): Int => {
  let mut i = 0;
  while i < arr.length {
    if arr[i] == target {
      return i;
    }
    i = i + 1;
  }
  return -1;
};

/// Algoritmo Binary Search (Búsqueda Binaria Iterativa).
///
/// Reduce a la mitad el espacio de búsqueda en cada iteración comparando
/// con el punto medio del segmento activo.
/// Requiere que el arreglo esté estrictamente ordenado de forma ascendente.
///
/// Parámetros:
///   - `arr`: Slice ordenado de enteros (`[]Int`).
///   - `target`: Valor entero buscado (`Int`).
///
/// Retorno:
///   - `Int`: Índice base 0 donde se ubica el elemento; -1 si no existe.
///
/// Complejidad:
///   - Temporal: O(log n)
///   - Espacial: O(1)
export fn binarySearch(arr: []Int, target: Int): Int => {
  let mut low = 0;
  let mut high = arr.length - 1;

  while low <= high {
    let mid = intDiv(low + high, 2);
    let midVal = arr[mid];

    if midVal == target {
      return mid;
    } else if midVal < target {
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }

  return -1;
};

/// Algoritmo Jump Search (Búsqueda por Saltos).
///
/// Avanza en bloques de tamaño óptimo sqrt(n) hasta rebasar el valor buscado
/// y luego ejecuta una búsqueda lineal dentro del bloque delimitado.
/// Requiere que el arreglo esté ordenado ascendentemente.
///
/// Parámetros:
///   - `arr`: Slice ordenado de enteros (`[]Int`).
///   - `target`: Valor entero buscado (`Int`).
///
/// Retorno:
///   - `Int`: Índice del elemento si fue localizado; -1 en caso contrario.
///
/// Complejidad:
///   - Temporal: O(sqrt(n))
///   - Espacial: O(1)
export fn jumpSearch(arr: []Int, target: Int): Int => {
  let n = arr.length;
  if n == 0 {
    return -1;
  }

  let mut step = integerSqrt(n);
  if step < 1 { step = 1; }

  let mut prev = 0;
  let mut curr = step;

  while curr < n && arr[curr] <= target {
    prev = curr;
    curr = curr + step;
  }

  let limit = if curr < n { curr + 1 } else { n };

  let mut i = prev;
  while i < limit {
    if arr[i] == target {
      return i;
    }
    i = i + 1;
  }

  return -1;
};

/// Algoritmo Ternary Search (Búsqueda Ternaria).
///
/// Divide el rango de búsqueda en tres tercios utilizando dos puntos medios (`mid1` y `mid2`).
/// Requiere que el arreglo se encuentre previamente ordenado.
///
/// Parámetros:
///   - `arr`: Slice ordenado de enteros (`[]Int`).
///   - `target`: Valor entero buscado (`Int`).
///
/// Retorno:
///   - `Int`: Índice donde reside el elemento; -1 si no fue encontrado.
///
/// Complejidad:
///   - Temporal: O(log_3 n)
///   - Espacial: O(1)
export fn ternarySearch(arr: []Int, target: Int): Int => {
  let mut low = 0;
  let mut high = arr.length - 1;

  while low <= high {
    let third = intDiv(high - low, 3);
    let mid1 = low + third;
    let mid2 = high - third;

    if arr[mid1] == target {
      return mid1;
    }
    if arr[mid2] == target {
      return mid2;
    }

    if target < arr[mid1] {
      high = mid1 - 1;
    } else if target > arr[mid2] {
      low = mid2 + 1;
    } else {
      low = mid1 + 1;
      high = mid2 - 1;
    }
  }

  return -1;
};

/// Encuentra el índice de la primera aparición (Lower Bound) de un valor en un arreglo ordenado con duplicados.
///
/// Parámetros:
///   - `arr`: Slice ordenado de enteros (`[]Int`).
///   - `target`: Valor entero buscado (`Int`).
///
/// Retorno:
///   - `Int`: Menor índice donde aparece `target`; -1 si no existe en la colección.
///
/// Complejidad:
///   - Temporal: O(log n)
///   - Espacial: O(1)
export fn findFirstOccurrence(arr: []Int, target: Int): Int => {
  let mut low = 0;
  let mut high = arr.length - 1;
  let mut result = -1;

  while low <= high {
    let mid = intDiv(low + high, 2);
    if arr[mid] == target {
      result = mid;
      high = mid - 1; // Continuar reduciendo hacia la izquierda
    } else if arr[mid] < target {
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }

  return result;
};

/// Encuentra el índice de la última aparición (Upper Bound) de un valor en un arreglo ordenado con duplicados.
///
/// Parámetros:
///   - `arr`: Slice ordenado de enteros (`[]Int`).
///   - `target`: Valor entero buscado (`Int`).
///
/// Retorno:
///   - `Int`: Mayor índice donde aparece `target`; -1 si no existe en la colección.
///
/// Complejidad:
///   - Temporal: O(log n)
///   - Espacial: O(1)
export fn findLastOccurrence(arr: []Int, target: Int): Int => {
  let mut low = 0;
  let mut high = arr.length - 1;
  let mut result = -1;

  while low <= high {
    let mid = intDiv(low + high, 2);
    if arr[mid] == target {
      result = mid;
      low = mid + 1; // Continuar reduciendo hacia la derecha
    } else if arr[mid] < target {
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }

  return result;
};
