// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/algorithms/searching.aura - Algoritmos de Búsqueda (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Estilo paquete estándar `search` / `slices` de Go.
//   - Nombres exportados canónicos en PascalCase (`BinarySearch`, `LinearSearch`).
//   - Uso de `len(s)` para cardinalidad sobre slices.
//   - Retornos explícitos de índices con convenciones Go (-1 para no encontrado).
//   - Funciones auxiliares de tipo `SearchInts` con `Result<Int, String>`.
//   - Wrappers funcionales de compatibilidad hacia atrás.
// ==============================================================================

fn intDiv(a: Int, b: Int): Int => {
  if b <= 0 || a < b { return 0; }
  let mut count = 0;
  let mut rem = a;
  while rem >= b {
    rem = rem - b;
    count = count + 1;
  }
  return count;
};

fn integerSqrt(n: Int): Int => {
  if n <= 0 { return 0; }
  let mut x = 1;
  let mut sq = x * x;
  while sq <= n {
    x = x + 1;
    sq = x * x;
  }
  return x - 1;
};

/// LinearSearch escanea secuencialmente cada posición hasta hallar el valor buscado.
export fn LinearSearch(arr: []Int, target: Int): Int => {
  let mut i = 0;
  let count = len(arr);
  while i < count {
    if arr[i] == target {
      return i;
    }
    i = i + 1;
  }
  return -1;
};

export fn linearSearch(arr: []Int, target: Int): Int => LinearSearch(arr, target);

/// BinarySearch busca dividiendo el rango ordenado en dos mitades en tiempo O(log n).
export fn BinarySearch(arr: []Int, target: Int): Int => {
  let mut low = 0;
  let mut high = len(arr) - 1;

  while low <= high {
    let mid = intDiv(low + high, 2);
    let midVal = arr[mid];

    if midVal == target {
      return mid;
    } else if midVal < target {
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }

  return -1;
};

export fn binarySearch(arr: []Int, target: Int): Int => BinarySearch(arr, target);

/// JumpSearch avanza en saltos de longitud óptima sqrt(n) sobre un slice ordenado.
export fn JumpSearch(arr: []Int, target: Int): Int => {
  let n = len(arr);
  if n == 0 {
    return -1;
  }

  let mut step = integerSqrt(n);
  if step < 1 { step = 1; }

  let mut prev = 0;
  let mut curr = step;

  while curr < n && arr[curr] <= target {
    prev = curr;
    curr = curr + step;
  }

  let limit = if curr < n { curr + 1 } else { n };

  let mut i = prev;
  while i < limit {
    if arr[i] == target {
      return i;
    }
    i = i + 1;
  }

  return -1;
};

export fn jumpSearch(arr: []Int, target: Int): Int => JumpSearch(arr, target);

/// TernarySearch divide el rango de búsqueda en tres tercios utilizando dos puntos medios.
export fn TernarySearch(arr: []Int, target: Int): Int => {
  let mut low = 0;
  let mut high = len(arr) - 1;

  while low <= high {
    let third = intDiv(high - low, 3);
    let mid1 = low + third;
    let mid2 = high - third;

    if arr[mid1] == target {
      return mid1;
    }
    if arr[mid2] == target {
      return mid2;
    }

    if target < arr[mid1] {
      high = mid1 - 1;
    } else if target > arr[mid2] {
      low = mid2 + 1;
    } else {
      low = mid1 + 1;
      high = mid2 - 1;
    }
  }

  return -1;
};

export fn ternarySearch(arr: []Int, target: Int): Int => TernarySearch(arr, target);

/// FindFirstOccurrence halla el menor índice (Lower Bound) de un valor en un slice ordenado.
export fn FindFirstOccurrence(arr: []Int, target: Int): Int => {
  let mut low = 0;
  let mut high = len(arr) - 1;
  let mut result = -1;

  while low <= high {
    let mid = intDiv(low + high, 2);
    if arr[mid] == target {
      result = mid;
      high = mid - 1;
    } else if arr[mid] < target {
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }

  return result;
};

export fn findFirstOccurrence(arr: []Int, target: Int): Int => FindFirstOccurrence(arr, target);

/// FindLastOccurrence halla el mayor índice (Upper Bound) de un valor en un slice ordenado.
export fn FindLastOccurrence(arr: []Int, target: Int): Int => {
  let mut low = 0;
  let mut high = len(arr) - 1;
  let mut result = -1;

  while low <= high {
    let mid = intDiv(low + high, 2);
    if arr[mid] == target {
      result = mid;
      low = mid + 1;
    } else if arr[mid] < target {
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }

  return result;
};

export fn findLastOccurrence(arr: []Int, target: Int): Int => FindLastOccurrence(arr, target);

/// SearchInts realiza una búsqueda binaria idiomática con retorno explícito de error estilo Go.
export fn SearchInts(arr: []Int, target: Int): Result<Int, String> => {
  let idx = BinarySearch(arr, target);
  if idx >= 0 {
    return Ok(idx);
  }
  return Err(`Elemento ${target} no encontrado en la colección`);
};
