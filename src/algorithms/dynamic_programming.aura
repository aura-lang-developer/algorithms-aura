// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/algorithms/dynamic_programming.aura - Programación Dinámica (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Funciones exportadas en PascalCase (`Fibonacci`, `Knapsack01`, etc.).
//   - Uso de `len(s)` para manejo canónico de colecciones y slices.
//   - Optimización de espacio en memoria constante O(1) o lineal O(W).
//   - Retornos tempranos y guard clauses.
//   - Wrappers funcionales de compatibilidad hacia atrás.
// ==============================================================================

/// Fibonacci calcula el n-ésimo término de Fibonacci con tabulación iterativa en O(1) espacio.
export fn Fibonacci(n: Int): Int => {
  if n <= 0 {
    return 0;
  }
  if n == 1 {
    return 1;
  }

  let mut prev2 = 0;
  let mut prev1 = 1;
  let mut current = 0;
  let mut i = 2;

  while i <= n {
    current = prev1 + prev2;
    prev2 = prev1;
    prev1 = current;
    i = i + 1;
  }

  return current;
};

export fn fibonacci(n: Int): Int => Fibonacci(n);

/// Knapsack01 resuelve el problema de la mochila 0/1 con tabla comprimida unidimensional.
export fn Knapsack01(weights: []Int, values: []Int, capacity: Int): Int => {
  let mut dp: []Int = [];
  let mut w = 0;
  while w <= capacity {
    dp.push(0);
    w = w + 1;
  }

  let mut i = 0;
  let numItems = len(weights);
  while i < numItems {
    let itemWeight = weights[i];
    let itemVal = values[i];
    let mut cap = capacity;

    while cap >= itemWeight {
      let withItem = dp[cap - itemWeight] + itemVal;
      if withItem > dp[cap] {
        dp[cap] = withItem;
      }
      cap = cap - 1;
    }

    i = i + 1;
  }

  return dp[capacity];
};

export fn knapsack01(weights: []Int, values: []Int, capacity: Int): Int => Knapsack01(weights, values, capacity);

/// LongestCommonSubsequence calcula la longitud de la subsecuencia común más larga (LCS).
export fn LongestCommonSubsequence(s1: String, s2: String): Int => {
  let m = len(s1);
  let n = len(s2);
  let totalCells = (m + 1) * (n + 1);

  let mut dp: []Int = [];
  let mut k = 0;
  while k < totalCells {
    dp.push(0);
    k = k + 1;
  }

  let mut i = 1;
  while i <= m {
    let mut j = 1;
    while j <= n {
      let idx = i * (n + 1) + j;
      let c1 = s1[i - 1];
      let c2 = s2[j - 1];

      if c1 == c2 {
        let diagIdx = (i - 1) * (n + 1) + (j - 1);
        dp[idx] = dp[diagIdx] + 1;
      } else {
        let upIdx = (i - 1) * (n + 1) + j;
        let leftIdx = i * (n + 1) + (j - 1);
        let up = dp[upIdx];
        let left = dp[leftIdx];
        dp[idx] = if up > left { up } else { left };
      }

      j = j + 1;
    }
    i = i + 1;
  }

  let resIdx = m * (n + 1) + n;
  return dp[resIdx];
};

export fn longestCommonSubsequence(s1: String, s2: String): Int => LongestCommonSubsequence(s1, s2);

/// MinCoinChange determina el número mínimo de monedas para sumar un monto exacto.
export fn MinCoinChange(coins: []Int, amount: Int): Int => {
  if amount <= 0 {
    return 0;
  }

  let infCoins = 999999;
  let mut dp: []Int = [];
  let mut a = 0;
  while a <= amount {
    dp.push(infCoins);
    a = a + 1;
  }
  dp[0] = 0;

  let mut i = 1;
  let numCoins = len(coins);
  while i <= amount {
    let mut c = 0;
    while c < numCoins {
      let coin = coins[c];
      if coin <= i {
        let prev = dp[i - coin];
        if prev != infCoins {
          let candidate = prev + 1;
          if candidate < dp[i] {
            dp[i] = candidate;
          }
        }
      }
      c = c + 1;
    }
    i = i + 1;
  }

  if dp[amount] == infCoins {
    return -1;
  }
  return dp[amount];
};

export fn minCoinChange(coins: []Int, amount: Int): Int => MinCoinChange(coins, amount);

/// MaxSubarraySum implementa el algoritmo de Kadane para la suma máxima de un subarreglo contiguo.
export fn MaxSubarraySum(arr: []Int): Int => {
  let count = len(arr);
  if count == 0 {
    return 0;
  }

  let mut maxSoFar = arr[0];
  let mut currentMax = arr[0];
  let mut i = 1;

  while i < count {
    let val = arr[i];
    let sum = currentMax + val;
    currentMax = if val > sum { val } else { sum };

    if currentMax > maxSoFar {
      maxSoFar = currentMax;
    }
    i = i + 1;
  }

  return maxSoFar;
};

export fn maxSubarraySum(arr: []Int): Int => MaxSubarraySum(arr);
