// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/algorithms/sorting.aura - Algoritmos de Ordenamiento (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Estilo paquete estándar `sort` de Go.
//   - Struct `SortStats` con método receptor `Summary()`.
//   - Nomenclatura idiomática Go en PascalCase (`BubbleSort`, `QuickSort`).
//   - Manipulación de slices Go con `len(s)` e indexación `[0:mid]`.
//   - Funciones wrapper en minúsculas para compatibilidad hacia atrás.
// ==============================================================================

/// Métricas estadísticas resultantes de una ejecución de ordenamiento.
export struct SortStats {
  __aura_type: String,
  algorithm: String,
  comparisons: Int,
  swaps: Int,
  isSorted: Bool,
};

/// Constructor idiomático estilo Go para crear una instancia de métricas de ordenamiento.
export fn NewSortStats(algo: String, comps: Int, swps: Int, sorted: Bool): SortStats => {
  {
    __aura_type: "SortStats",
    algorithm: algo,
    comparisons: comps,
    swaps: swps,
    isSorted: sorted,
  }
};

/// Summary genera un informe formateado de las métricas de ordenamiento.
fn (s: SortStats) Summary(): String => {
  let status = if s.isSorted { "OK (Ordenado)" } else { "FALLO (Desordenado)" };
  `[${s.algorithm}] Estado: ${status} | Comparaciones: ${s.comparisons} | Intercambios: ${s.swaps}`
}

/// CloneSlice clona un slice de enteros creando una copia contigua independiente en memoria.
export fn CloneSlice(arr: []Int): []Int => {
  let mut copy: []Int = [];
  let mut i = 0;
  let count = len(arr);
  while i < count {
    copy.push(arr[i]);
    i = i + 1;
  }
  return copy;
};

export fn cloneArray(arr: []Int): []Int => CloneSlice(arr);

/// IsSorted verifica si los elementos de un slice se encuentran en orden no decreciente.
export fn IsSorted(arr: []Int): Bool => {
  let count = len(arr);
  if count <= 1 {
    return true;
  }
  let mut i = 0;
  while i < (count - 1) {
    if arr[i] > arr[i + 1] {
      return false;
    }
    i = i + 1;
  }
  return true;
};

export fn isSorted(arr: []Int): Bool => IsSorted(arr);

/// BubbleSort ordena un slice de enteros mediante pasadas e intercambios adyacentes.
export fn BubbleSort(arr: []Int): []Int => {
  let a = CloneSlice(arr);
  let count = len(a);
  if count <= 1 {
    return a;
  }

  let mut i = 0;
  while i < count {
    let mut swapped = false;
    let mut j = 0;
    while j < (count - i - 1) {
      if a[j] > a[j + 1] {
        let temp = a[j];
        a[j] = a[j + 1];
        a[j + 1] = temp;
        swapped = true;
      }
      j = j + 1;
    }
    if !swapped {
      return a;
    }
    i = i + 1;
  }

  return a;
};

export fn bubbleSort(arr: []Int): []Int => BubbleSort(arr);

/// SelectionSort busca repetidamente el elemento mínimo del segmento restante.
export fn SelectionSort(arr: []Int): []Int => {
  let a = CloneSlice(arr);
  let count = len(a);
  if count <= 1 {
    return a;
  }

  let mut i = 0;
  while i < (count - 1) {
    let mut minIdx = i;
    let mut j = i + 1;
    while j < count {
      if a[j] < a[minIdx] {
        minIdx = j;
      }
      j = j + 1;
    }

    if minIdx != i {
      let temp = a[i];
      a[i] = a[minIdx];
      a[minIdx] = temp;
    }
    i = i + 1;
  }

  return a;
};

export fn selectionSort(arr: []Int): []Int => SelectionSort(arr);

/// InsertionSort ordena construyendo el arreglo final elemento por elemento.
export fn InsertionSort(arr: []Int): []Int => {
  let a = CloneSlice(arr);
  let count = len(a);
  if count <= 1 {
    return a;
  }

  let mut i = 1;
  while i < count {
    let key = a[i];
    let mut j = i - 1;

    while j >= 0 && a[j] > key {
      a[j + 1] = a[j];
      j = j - 1;
    }
    a[j + 1] = key;

    i = i + 1;
  }

  return a;
};

export fn insertionSort(arr: []Int): []Int => InsertionSort(arr);

fn merge(left: []Int, right: []Int): []Int => {
  let mut merged: []Int = [];
  let mut lIdx = 0;
  let mut rIdx = 0;
  let lLen = len(left);
  let rLen = len(right);

  while lIdx < lLen && rIdx < rLen {
    if left[lIdx] <= right[rIdx] {
      merged.push(left[lIdx]);
      lIdx = lIdx + 1;
    } else {
      merged.push(right[rIdx]);
      rIdx = rIdx + 1;
    }
  }

  while lIdx < lLen {
    merged.push(left[lIdx]);
    lIdx = lIdx + 1;
  }

  while rIdx < rLen {
    merged.push(right[rIdx]);
    rIdx = rIdx + 1;
  }

  return merged;
};

fn intDiv(a: Int, b: Int): Int => {
  if b <= 0 || a < b { return 0; }
  let mut count = 0;
  let mut rem = a;
  while rem >= b {
    rem = rem - b;
    count = count + 1;
  }
  return count;
};

/// MergeSort aplica divide y vencerás para ordenar en tiempo O(n log n).
export fn MergeSort(arr: []Int): []Int => {
  let count = len(arr);
  if count <= 1 {
    return CloneSlice(arr);
  }

  let mid = intDiv(count, 2);
  let leftPart = arr[0:mid];
  let rightPart = arr[mid:count];

  let sortedLeft = MergeSort(leftPart);
  let sortedRight = MergeSort(rightPart);

  return merge(sortedLeft, sortedRight);
};

export fn mergeSort(arr: []Int): []Int => MergeSort(arr);

fn quickSortRecursive(a: []Int, low: Int, high: Int): Unit => {
  if low >= high {
    return;
  }

  let pivot = a[high];
  let mut i = low - 1;
  let mut j = low;

  while j < high {
    if a[j] <= pivot {
      i = i + 1;
      let temp = a[i];
      a[i] = a[j];
      a[j] = temp;
    }
    j = j + 1;
  }

  let pivotPos = i + 1;
  let temp = a[pivotPos];
  a[pivotPos] = a[high];
  a[high] = temp;

  quickSortRecursive(a, low, pivotPos - 1);
  quickSortRecursive(a, pivotPos + 1, high);
  return;
};

/// QuickSort particiona in-place alrededor de un pivote en tiempo promedio O(n log n).
export fn QuickSort(arr: []Int): []Int => {
  let a = CloneSlice(arr);
  let count = len(a);
  if count <= 1 {
    return a;
  }
  quickSortRecursive(a, 0, count - 1);
  return a;
};

export fn quickSort(arr: []Int): []Int => QuickSort(arr);
