// ==============================================================================
// Algoritmos y Estructuras en Aura Lang (Estilo Golang v2.0)
// src/algorithms/graphs.aura - Recorridos (BFS/DFS) y Dijkstra (Go Style)
// ==============================================================================
// Principios Golang aplicados:
//   - Uso directo de métodos con receptor sobre la estructura `Graph`.
//   - Nombres exportados canónicos en PascalCase (`BFS`, `DFS`, `Dijkstra`).
//   - Slices nativos Go y consultas con `len(s)`.
//   - Retornos tempranos y guard clauses.
//   - Wrappers funcionales de compatibilidad hacia atrás.
// ==============================================================================

import {
  Graph,
  GraphEdge,
  GraphVertex,
  vertexCount
} from "../structures/graph";

/// BFS ejecuta un Recorrido en Anchura (Breadth-First Search) desde `startId`.
export fn BFS(g: Graph, startId: Int): []Int => {
  let totalV = g.VertexCount();
  let mut order: []Int = [];
  if startId < 0 || startId >= totalV {
    return order;
  }

  let mut visited: []Bool = [];
  let mut i = 0;
  while i < totalV {
    visited.push(false);
    i = i + 1;
  }

  let mut queue: []Int = [startId];
  let mut head = 0;
  visited[startId] = true;

  while head < len(queue) {
    let curr = queue[head];
    head = head + 1;
    order.push(curr);

    let edges = g.vertices[curr].edges;
    let mut eIdx = 0;
    let numEdges = len(edges);
    while eIdx < numEdges {
      let neighbor = edges[eIdx].to;
      if !visited[neighbor] {
        visited[neighbor] = true;
        queue.push(neighbor);
      }
      eIdx = eIdx + 1;
    }
  }

  return order;
};

export fn bfs(g: Graph, startId: Int): []Int => BFS(g, startId);

/// DFSRecursive es la rutina recursiva auxiliar para el recorrido en profundidad.
export fn DFSRecursive(g: Graph, curr: Int, visited: []Bool, order: []Int): Unit => {
  visited[curr] = true;
  order.push(curr);

  let edges = g.vertices[curr].edges;
  let mut i = 0;
  let numEdges = len(edges);
  while i < numEdges {
    let neighbor = edges[i].to;
    if !visited[neighbor] {
      DFSRecursive(g, neighbor, visited, order);
    }
    i = i + 1;
  }
  return;
};

export fn dfsRecursive(g: Graph, curr: Int, visited: []Bool, order: []Int): Unit => {
  DFSRecursive(g, curr, visited, order);
  return;
};

/// DFS ejecuta un Recorrido en Profundidad (Depth-First Search) desde `startId`.
export fn DFS(g: Graph, startId: Int): []Int => {
  let totalV = g.VertexCount();
  let mut order: []Int = [];
  if startId < 0 || startId >= totalV {
    return order;
  }

  let mut visited: []Bool = [];
  let mut i = 0;
  while i < totalV {
    visited.push(false);
    i = i + 1;
  }

  DFSRecursive(g, startId, visited, order);
  return order;
};

export fn dfs(g: Graph, startId: Int): []Int => DFS(g, startId);

/// Dijkstra calcula las distancias mínimas desde `startId` a todos los vértices.
export fn Dijkstra(g: Graph, startId: Int): []Int => {
  let totalV = g.VertexCount();
  let infDist = 999999;
  let mut dist: []Int = [];
  let mut visited: []Bool = [];

  let mut i = 0;
  while i < totalV {
    dist.push(infDist);
    visited.push(false);
    i = i + 1;
  }

  if startId < 0 || startId >= totalV {
    return dist;
  }

  dist[startId] = 0;

  let mut count = 0;
  while count < totalV {
    let mut minDistance = infDist;
    let mut minVertex = -1;

    let mut v = 0;
    while v < totalV {
      let isVis = visited[v];
      if !isVis && dist[v] <= minDistance {
        minDistance = dist[v];
        minVertex = v;
      }
      v = v + 1;
    }

    if minVertex == -1 || minDistance == infDist {
      count = totalV;
    } else {
      visited[minVertex] = true;

      let edges = g.vertices[minVertex].edges;
      let mut e = 0;
      let numEdges = len(edges);
      while e < numEdges {
        let neighbor = edges[e].to;
        let weight = edges[e].weight;
        let newDist = dist[minVertex] + weight;

        if !visited[neighbor] && newDist < dist[neighbor] {
          dist[neighbor] = newDist;
        }
        e = e + 1;
      }

      count = count + 1;
    }
  }

  return dist;
};

export fn dijkstra(g: Graph, startId: Int): []Int => Dijkstra(g, startId);

/// IsConnected determina si todos los vértices del grafo son alcanzables a partir de `startId`.
export fn IsConnected(g: Graph, startId: Int): Bool => {
  let visitedNodes = BFS(g, startId);
  return len(visitedNodes) == g.VertexCount();
};

export fn isConnected(g: Graph, startId: Int): Bool => IsConnected(g, startId);
